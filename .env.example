# Скопируйте в .env (файл .env в git не попадает) и заполните.
# Сгенерировать ключ:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=замените-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных: sqlite (по умолчанию) или postgres
DB_ENGINE=sqlite
# DB_NAME=photostudio
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Почта: по умолчанию письма печатаются в консоль сервера.
# Для реальной отправки:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
